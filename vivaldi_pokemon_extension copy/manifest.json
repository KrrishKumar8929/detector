{
  "manifest_version": 3,
  "name": "Pokémon Detector for Vivaldi - Beta",
  "version": "0.9.1",
  "description": "Fixes floating panel visibility and improves startup diagnostics; supports selected Discord tabs and global stop.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://discord.com/*",
    "https://*.discord.com/*",
    "https://cdn.discordapp.com/*",
    "https://media.discordapp.net/*",
    "http://127.0.0.1:8765/*",
    "https://unpkg.com/*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Pokémon Detector",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/*",
        "https://*.discord.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
